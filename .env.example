# Database (local)
DATABASE_URL="postgresql://nyumbahub:nyumbahub@localhost:5432/nyumbahub?schema=public"
# Vercel + Neon sets POSTGRES_* automatically. For local dev, map from DATABASE_URL:
POSTGRES_PRISMA_URL="postgresql://nyumbahub:nyumbahub@localhost:5432/nyumbahub?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://nyumbahub:nyumbahub@localhost:5432/nyumbahub?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
# Local
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Railway production — set both to your public URL, e.g. https://nyumbahub-production.up.railway.app
# AUTH_TRUST_HOST=true

# OAuth (optional — Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gmail SMTP — registration verification codes (Google App Password)
# 1. Google Account → Security → turn on 2-Step Verification
# 2. App passwords → Mail → generate password
# 3. Paste below (spaces optional; they are stripped)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional override; defaults to "Your Home <GMAIL_USER>"
# EMAIL_FROM="Your Home <you@gmail.com>"

# Cloudinary (optional — photos also upload to Vercel Blob when BLOB_READ_WRITE_TOKEN is set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Vercel Blob — created automatically for production; local `vercel env pull` fills this
# BLOB_READ_WRITE_TOKEN=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# M-Pesa (Daraja API / Lipa Na M-Pesa Online)
# From https://developer.safaricom.co.ke — create an app + Lipa Na M-Pesa Online
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="7746713"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://yourhome.co.ke/api/payments/mpesa/callback"
MPESA_ENV="production"
# Use CustomerBuyGoodsOnline for Till numbers; CustomerPayBillOnline for Paybill
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"

# AI (OpenAI-compatible)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Your Home"
