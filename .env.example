# Database (Railway: reference Postgres → DATABASE_URL=${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://nyumbahub:nyumbahub@localhost:5432/nyumbahub?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
# Local
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Railway production — set both to your public URL, e.g. https://nyumbahub-production.up.railway.app
# AUTH_TRUST_HOST=true

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (required for real image uploads in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# M-Pesa (Daraja API)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/mpesa/callback"
MPESA_ENV="sandbox"

# AI (OpenAI-compatible)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NyumbaHub Kenya"
