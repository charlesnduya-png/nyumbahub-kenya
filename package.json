{
  "name": "nyumbahub-kenya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/ensure-db-env.js && prisma generate && next build",
    "postinstall": "node scripts/ensure-db-env.js && prisma generate",
    "start": "node server.js",
    "start:local": "next start",
    "start:railway": "prisma migrate deploy && node server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/ensure-db-env.js && prisma migrate deploy",
    "db:seed": "node scripts/ensure-db-env.js && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
