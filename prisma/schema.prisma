generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  BUYER
  SELLER
  AGENT
  JOB_PARTNER
  ADMIN
}

enum ListingType {
  BUY
  RENT
  LAND
  COMMERCIAL
  HOLIDAY
  HOTEL
}

enum PropertyType {
  APARTMENT
  HOUSE
  TOWNHOUSE
  VILLA
  STUDIO
  BUNGALOW
  MAISONETTE
  PENTHOUSE
  OFFICE
  SHOP
  WAREHOUSE
  PLOT
  FARM
  HOTEL
  OTHER
}

enum PropertyStatus {
  DRAFT
  PENDING
  ACTIVE
  SOLD
  RENTED
  EXPIRED
  REJECTED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  STRIPE
  CARD
}

enum WalletTxType {
  BOOKING
  RENT
  SALE
  PAYOUT
  ADJUSTMENT
  HOTEL_RECRUITMENT
}

enum WalletTxStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  CANCELLED
}

enum WalletPayoutMethod {
  MOBILE_MONEY
  BANK
  DIGITAL_WALLET
}

enum EscrowHoldStatus {
  NONE
  AWAITING_PAYMENT
  HELD
  RELEASED
  REFUNDED
}

enum PlatformCommissionStatus {
  ACCRUED
  COLLECTED
  REFUNDED
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  AGENT_PRO
  AGENT_ENTERPRISE
  TENANT_PASS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING_SCHEDULED
  NEGOTIATING
  WON
  LOST
}

enum NotificationType {
  LEAD
  MESSAGE
  PAYMENT
  LISTING
  SYSTEM
  ALERT
  BOOKING
  AGENT_REPORT
  OFFER
  RENTAL_RESERVATION
}

enum RentalReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  RENTED
}

enum RentPaymentStatus {
  UNPAID
  PAID
}

enum RentalRoomStatus {
  AVAILABLE
  RENTED
}

enum RentalRepublishStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AgentReportReason {
  FRAUD
  HARASSMENT
  MISLEADING
  UNRESPONSIVE
  OTHER
}

enum AgentReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum AdPlacement {
  HOME_BANNER
  SIDEBAR
  SEARCH_SPONSORED
  PROPERTY_DETAIL
}

model User {
  id                    String             @id @default(cuid())
  name                  String?
  email                 String             @unique
  emailVerified         DateTime?
  phone                 String?            @unique
  phoneVerified         DateTime?
  passwordHash          String?
  image                 String?
  role                  Role               @default(BUYER)
  bio                   String?
  nationalId            String?
  nationalIdVerified    VerificationStatus @default(UNVERIFIED)
  titleDeedVerified     VerificationStatus @default(UNVERIFIED)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  isActive              Boolean            @default(true)
  /// Admin-set cap on active listings. null = use plan tier; -1 = unlimited.
  listingLimitOverride  Int?
  referredByJobPartnerUserId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  referredByJobPartner  User?              @relation("JobPartnerReferrals", fields: [referredByJobPartnerUserId], references: [id], onDelete: SetNull)
  jobPartnerReferrals   User[]             @relation("JobPartnerReferrals")
  jobPartnerProfile     JobPartnerProfile?

  accounts              Account[]
  sessions              Session[]
  properties            Property[]         @relation("PropertyOwner")
  agentProfile          Agent?
  leadsAsBuyer          Lead[]             @relation("BuyerLeads")
  leadsAsAgent          Lead[]             @relation("AgentLeads")
  messagesSent          Message[]          @relation("SentMessages")
  messagesReceived      Message[]          @relation("ReceivedMessages")
  reviews               Review[]
  subscriptions         Subscription[]
  payments              Payment[]
  blogPosts             BlogPost[]
  notifications         Notification[]
  favorites             Favorite[]
  recentlyViewed        RecentlyViewed[]
  savedSearches         SavedSearch[]
  comparisons           PropertyComparison[]
  viewings              Viewing[]          @relation("BuyerViewings")
  advertisements        Advertisement[]
  priceAlerts           PriceAlert[]
  bookingsAsGuest       Booking[]          @relation("GuestBookings")
  agentReportsSubmitted AgentReport[]
  propertyOffersMade    PropertyOffer[]
  rentalReservations    RentalReservation[]
  rentalRepublishRequests RentalRepublishRequest[] @relation("RepublishRequester")
  rentalPlots           RentalPlot[] @relation("PlotOwner")
  mediaAssets           MediaAsset[]
  accountTeamOwned     AccountTeam?
  accountTeamMembers   AccountTeamMember[]
  rentPaymentsAsTenant RentalRentPayment[] @relation("RentTenant")
  rentPaymentsMarked   RentalRentPayment[] @relation("RentMarkedBy")
  wallet               ProfessionalWallet?
  walletTransactions   WalletTransaction[]
  bnbCommissionsHosted PlatformCommission[]
  hotelPackagesOwned     HotelPackage[]         @relation("HotelPackageOwner")
  hotelRequestsOwned     HotelServiceRequest[]  @relation("HotelRequestOwner")
  hotelRequestsAsGuest   HotelServiceRequest[]  @relation("HotelRequestGuest")
  hotelPlan              HotelAccountPlan?

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Agent {
  id              String             @id @default(cuid())
  userId          String             @unique
  agencyName      String?
  licenseNumber   String?
  specialty       String?
  yearsExperience Int                @default(0)
  rating          Float              @default(0)
  reviewCount     Int                @default(0)
  totalSales      Int                @default(0)
  bio             String?            @db.Text
  website         String?
  facebookUrl     String?
  instagramUrl    String?
  linkedinUrl     String?
  twitterUrl      String?
  tiktokUrl       String?
  county          String?
  town            String?
  isFeatured      Boolean            @default(false)
  isVerified      Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients         Client[]
  listings        Property[]         @relation("AgentListings")
  reports         AgentReport[]
  rentalRepublishRequests RentalRepublishRequest[]
  rentalPlots     RentalPlot[] @relation("PlotAgent")

  @@index([isFeatured])
  @@index([county])
}

model AgentReport {
  id         String             @id @default(cuid())
  agentId    String
  reporterId String
  reason     AgentReportReason
  details    String?            @db.Text
  status     AgentReportStatus  @default(PENDING)
  adminNotes String?            @db.Text
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  agent      Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reporter   User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@index([reporterId])
}

model PropertyOffer {
  id         String              @id @default(cuid())
  propertyId String
  buyerId    String
  amount     Float
  currency   String              @default("KES")
  message    String?             @db.Text
  status     PropertyOfferStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer      User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([buyerId])
  @@index([status])
}

model RentalReservation {
  id           String                  @id @default(cuid())
  propertyId   String
  rentalRoomId String?
  tenantId     String
  moveInDate   DateTime?
  message      String?                 @db.Text
  status       RentalReservationStatus @default(PENDING)
  adminNotes   String?                 @db.Text
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  property     Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentalRoom   PropertyRentalRoom?     @relation(fields: [rentalRoomId], references: [id], onDelete: SetNull)
  tenant       User                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  republishRequests RentalRepublishRequest[]

  @@index([propertyId])
  @@index([rentalRoomId])
  @@index([tenantId])
  @@index([status])
}

model RentalRentPayment {
  id          String            @id @default(cuid())
  propertyId  String
  tenantId    String?
  year        Int
  month       Int
  amountDue   Float
  amountPaid  Float             @default(0)
  status      RentPaymentStatus @default(UNPAID)
  paidAt      DateTime?
  notes       String?
  markedById  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      User?             @relation("RentTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  markedBy    User?             @relation("RentMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, year, month])
  @@index([propertyId, year, month])
  @@index([status])
}

model RentalRepublishRequest {
  id                 String               @id @default(cuid())
  propertyId         String
  rentalReservationId String
  requesterId        String
  agentId            String?
  reason             String?              @db.Text
  status             RentalRepublishStatus @default(PENDING)
  adminNotes         String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentalReservation  RentalReservation  @relation(fields: [rentalReservationId], references: [id], onDelete: Cascade)
  requester          User                @relation("RepublishRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  agent              Agent?              @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
  @@index([agentId])
  @@index([requesterId])
}

model Client {
  id        String   @id @default(cuid())
  agentId   String
  name      String
  email     String?
  phone     String?
  notes     String?  @db.Text
  status    String   @default("ACTIVE")
  budget    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

/// Landlord compound / apartment block — not the same as PropertyType.PLOT (land for sale).
model RentalPlot {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  country     String   @default("Kenya")
  county      String
  town        String
  estate      String?
  address     String?
  latitude    Float?
  longitude   Float?
  ownerId     String
  agentId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("PlotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  agent       Agent?   @relation("PlotAgent", fields: [agentId], references: [id])
  units       Property[]

  @@index([ownerId])
  @@index([agentId])
  @@index([county, town])
  @@index([country])
}

model Property {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  description       String         @db.Text
  listingType       ListingType
  propertyType      PropertyType
  status            PropertyStatus @default(DRAFT)
  price             Float
  currency          String         @default("KES")
  /// Host-set percent off `price`. 0 means no discount. Sale price is derived at display/checkout.
  discountPercent   Int            @default(0)
  pricePerSqft      Float?
  bedrooms          Int?
  bathrooms         Int?
  parkingSpaces     Int            @default(0)
  floorArea         Float?
  plotSize          Float?
  yearBuilt         Int?
  furnished         Boolean        @default(false)
  swimmingPool      Boolean        @default(false)
  security          Boolean        @default(false)
  country           String         @default("Kenya")
  county            String
  town              String
  estate            String?
  address           String?
  latitude          Float?
  longitude         Float?
  isFeatured        Boolean        @default(false)
  isSponsored       Boolean        @default(false)
  isPremium         Boolean        @default(false)
  isVerified        Boolean        @default(false)
  views             Int            @default(0)
  expiresAt         DateTime?
  publishedAt       DateTime?
  ownerId           String
  agentId           String?
  rentalPlotId      String?
  unitLabel         String?
  unitFloor         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner             User           @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  agent             Agent?         @relation("AgentListings", fields: [agentId], references: [id])
  rentalPlot        RentalPlot?    @relation(fields: [rentalPlotId], references: [id], onDelete: SetNull)
  images            PropertyImage[]
  videos            PropertyVideo[]
  amenities         PropertyAmenity[]
  leads             Lead[]
  reviews           Review[]
  favorites         Favorite[]
  recentlyViewed    RecentlyViewed[]
  priceHistory      PriceHistory[]
  nearbyPlaces      NearbyPlace[]
  viewings          Viewing[]
  comparisons       ComparisonItem[]
  bookings          Booking[]
  offers            PropertyOffer[]
  rentalReservations RentalReservation[]
  hotelPackages      HotelPackage[]
  hotelServiceRequests HotelServiceRequest[]
  rentalRepublishRequests RentalRepublishRequest[]
  rentalRooms       PropertyRentalRoom[]
  rentPayments      RentalRentPayment[]

  @@index([listingType, status])
  @@index([county, town])
  @@index([country])
  @@index([price])
  @@index([isFeatured])
  @@index([ownerId])
  @@index([slug])
  @@index([rentalPlotId])
}

/// Bookable room / unit inside a single RENT listing (house stays listed until all are rented).
model PropertyRentalRoom {
  id         String          @id @default(cuid())
  propertyId String
  label      String
  floor      String?
  price      Float?
  status     RentalRoomStatus @default(AVAILABLE)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations RentalReservation[]

  @@index([propertyId, status])
}

model Booking {
  id           String        @id @default(cuid())
  propertyId   String
  guestId      String
  checkIn      DateTime
  checkOut     DateTime
  guests       Int           @default(1)
  nights       Int
  totalAmount  Float
  listAmount   Float         @default(0)
  memberDiscountAmount Float @default(0)
  memberLevel  Int           @default(1)
  currency     String        @default("KES")
  commissionAmount Float     @default(0)
  hostAmount   Float         @default(0)
  escrowStatus EscrowHoldStatus @default(NONE)
  status       BookingStatus @default(PENDING)
  guestMessage String?       @db.Text
  ownerNote    String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest        User          @relation("GuestBookings", fields: [guestId], references: [id], onDelete: Cascade)
  platformCommission PlatformCommission?
  review       Review?

  @@index([propertyId, status])
  @@index([guestId])
  @@index([status, createdAt])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String   @db.Text
  publicId   String?
  alt        String?
  order      Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  publicId  String   @unique
  url       String   @db.Text
  mimeType  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PropertyVideo {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String?
  title      String?
  thumbnail  String?
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Amenity {
  id         String           @id @default(cuid())
  name       String           @unique
  icon       String?
  category   String?
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Lead {
  id          String     @id @default(cuid())
  propertyId  String
  buyerId     String?
  agentId     String?
  name        String
  email       String?
  phone       String?
  message     String?    @db.Text
  status      LeadStatus @default(NEW)
  source      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer       User?      @relation("BuyerLeads", fields: [buyerId], references: [id])
  agent       User?      @relation("AgentLeads", fields: [agentId], references: [id])

  @@index([propertyId])
  @@index([status])
  @@index([agentId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  isRead     Boolean  @default(false)
  propertyId String?
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model Review {
  id            String    @id @default(cuid())
  propertyId    String
  userId        String
  bookingId     String?   @unique
  rating        Int
  cleanliness   Int       @default(0)
  locationScore Int       @default(0)
  value         Int       @default(0)
  comfort       Int       @default(0)
  staff         Int       @default(0)
  liked         String?   @db.Text
  disliked      String?   @db.Text
  comment       String?   @db.Text
  hostReply     String?   @db.Text
  hostRepliedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([propertyId, userId])
  @@index([propertyId])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  autoRenew Boolean            @default(true)
  amount    Float              @default(0)
  currency  String             @default("KES")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([userId, status])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  currency       String        @default("KES")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?       @unique
  mpesaReceipt   String?
  stripeIntentId String?
  description    String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([status])
}

model ProfessionalWallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  availableBalance Float               @default(0)
  pendingBalance   Float               @default(0)
  lifetimeEarned   Float               @default(0)
  lifetimePaidOut  Float               @default(0)
  currency         String              @default("KES")
  payoutMethod     WalletPayoutMethod?
  payoutAccountName String?
  payoutPhone      String?
  payoutProvider   String?
  payoutBankName   String?
  payoutBankAccount String?
  payoutBankBranch String?
  payoutCountry    String?
  payoutSwift      String?
  payoutEmail      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]

  @@index([lifetimeEarned])
}

model WalletTransaction {
  id          String          @id @default(cuid())
  walletId    String
  userId      String
  type        WalletTxType
  status      WalletTxStatus  @default(PENDING)
  amount      Float
  grossAmount Float           @default(0)
  feeAmount   Float           @default(0)
  currency    String          @default("KES")
  sourceType  String
  sourceId    String
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  clearedAt   DateTime?

  wallet      ProfessionalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([walletId, status])
  @@index([status, createdAt])
}

model PlatformCommission {
  id               String                    @id @default(cuid())
  bookingId        String                    @unique
  hostUserId       String
  guestUserId      String
  grossAmount      Float
  commissionAmount Float
  hostAmount       Float
  currency         String                    @default("KES")
  status           PlatformCommissionStatus  @default(ACCRUED)
  collectedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  booking          Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  host             User                      @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([hostUserId])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  category    String
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([category, published])
  @@index([slug])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model RecentlyViewed {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  viewedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, viewedAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  alertOn   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  propertyId String
  price      Float
  recordedAt DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, recordedAt])
}

model NearbyPlace {
  id         String  @id @default(cuid())
  propertyId String
  name       String
  type       String
  distance   Float?
  latitude   Float?
  longitude  Float?

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, type])
}

model Viewing {
  id         String   @id @default(cuid())
  propertyId String
  buyerId    String
  scheduledAt DateTime
  status     String   @default("SCHEDULED")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer      User     @relation("BuyerViewings", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([buyerId])
}

model PropertyComparison {
  id        String           @id @default(cuid())
  userId    String
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ComparisonItem[]

  @@index([userId])
}

model ComparisonItem {
  comparisonId String
  propertyId   String

  comparison   PropertyComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([comparisonId, propertyId])
}

model Advertisement {
  id         String      @id @default(cuid())
  title      String
  imageUrl   String
  linkUrl    String?
  placement  AdPlacement
  isActive   Boolean     @default(true)
  startDate  DateTime?
  endDate    DateTime?
  clicks     Int         @default(0)
  impressions Int        @default(0)
  advertiserId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  advertiser User?       @relation(fields: [advertiserId], references: [id])

  @@index([placement, isActive])
}

model PriceAlert {
  id        String   @id @default(cuid())
  userId    String
  county    String?
  town      String?
  maxPrice  Float?
  listingType ListingType?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SiteVisit {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId, path, createdAt])
}

enum TeamRole {
  FULL
  LISTINGS
  INQUIRIES
  VIEWINGS
  OFFERS
  BOOKINGS
  MESSAGES
  RENTALS
  READ
}

// A team/workspace is owned by a single user account (the agent or land owner).
// Team members are additional user accounts that can act on behalf of that owner.
model AccountTeam {
  id        String                @id @default(cuid())
  ownerId   String                @unique
  owner     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   AccountTeamMember[]
  invites   AccountTeamInvite[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model AccountTeamMember {
  id        String     @id @default(cuid())
  teamId    String
  userId    String     @unique
  roles     TeamRole[]
  team      AccountTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([teamId])
}

model AccountTeamInvite {
  id         String     @id @default(cuid())
  teamId     String
  email      String
  roles      TeamRole[]
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())
  team       AccountTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}

enum HotelServiceCategory {
  GROUP_BOOKING
  EVENT_CONFERENCE
  EVENT_BOOKING_REQUEST
  SPORTS_TEAM
  COOPERATIVE
  HOTEL_OFFER
}

enum HotelPlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum AgencyPlanTier {
  FREE
  BASIC
  PRO
  PREMIUM
  ENTERPRISE
}

enum HotelServiceRequestStatus {
  NEW
  REVIEWING
  QUOTED
  CONFIRMED
  DECLINED
  CANCELLED
}

/// Published packages — group stays, events, sports blocks, corporate rates, promos
model HotelPackage {
  id          String               @id @default(cuid())
  ownerId     String
  propertyId  String?
  category    HotelServiceCategory
  title       String
  description String               @db.Text
  minGuests   Int?
  maxGuests   Int?
  minRooms    Int?
  priceFrom   Float?
  priceTo     Float?
  currency    String               @default("KES")
  isActive    Boolean              @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  terms       String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  owner       User                 @relation("HotelPackageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  property    Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  requests    HotelServiceRequest[]

  @@index([ownerId, category])
  @@index([propertyId])
  @@index([isActive])
}

/// Incoming booking requests from guests — quote, confirm, or decline
model HotelServiceRequest {
  id             String                      @id @default(cuid())
  packageId      String?
  propertyId     String?
  ownerId        String
  guestId        String?
  category       HotelServiceCategory
  contactName    String
  contactEmail   String?
  contactPhone   String?
  organization   String?
  eventTitle     String?
  checkIn        DateTime?
  checkOut       DateTime?
  guestCount     Int?
  roomCount      Int?
  message        String?                     @db.Text
  status         HotelServiceRequestStatus   @default(NEW)
  ownerNote      String?                     @db.Text
  quotedAmount   Float?
  currency       String                      @default("KES")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  package        HotelPackage?               @relation(fields: [packageId], references: [id], onDelete: SetNull)
  property       Property?                   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  owner          User                        @relation("HotelRequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  guest          User?                       @relation("HotelRequestGuest", fields: [guestId], references: [id], onDelete: SetNull)

  @@index([ownerId, category])
  @@index([propertyId])
  @@index([status])
  @@index([guestId])
}

/// Professional hotel operator plan — Free through Enterprise
model HotelAccountPlan {
  id        String        @id @default(cuid())
  userId    String        @unique
  tier      HotelPlanTier @default(FREE)
  startDate DateTime      @default(now())
  endDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
}

/// Admin-configurable monthly prices for hotel operator plan tiers
model HotelPlanPriceConfig {
  tier      HotelPlanTier @id
  price     Float
  currency  String        @default("KES")
  updatedAt DateTime      @updatedAt
}

/// Admin-configurable listing caps per agency plan tier
model AgencyPlanListingConfig {
  tier        AgencyPlanTier @id
  maxListings Int?
  updatedAt   DateTime       @updatedAt
}

/// Hotel recruitment partner — earns commission on referred hotel plan payments
model JobPartnerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  referralCode   String   @unique
  hotelsReferred Int      @default(0)
  bio            String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referralCode])
}
